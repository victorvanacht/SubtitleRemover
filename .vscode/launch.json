{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train Mask Estimator (Default)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train_mask_estimator.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--train-root", ".\\cocodataset\\train",
                "--validate-root", ".\\cocodataset\\validate",
                "--batch-size", "8",
                "--epochs", "20",
                "--num-workers", "0"
            ]
        },
        {
            "name": "Train Mask Estimator (Custom Settings)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train_mask_estimator.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--train-root", ".\\..\\cocodataset\\unlabeled2017",
                "--validate-root", ".\\..\\cocodataset\\val2017",
                "--batch-size", "32",
                "--epochs", "10",
                "--num-workers", "4",
                "--learning-rate", "1e-3",
                "--max-train-samples", "10000",
                "--max-validation-samples", "10000"
            ]
        },
        {
            "name": "Inference (Best Model)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/infere.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--data-root", ".\\cocodataset\\validate",
                "--checkpoint_mask_estimator", ".\\artifacts\\best_mask_estimator.pt",
                "--output", ".\\artifacts\\inference_preview.png",
                "--num-examples", "4",
                "--batch-size", "4",
                "--num-workers", "0",
                "--threshold", "0.5"
            ]
        },
        {
            "name": "Inference (Last Model)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/infere.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--data-root", ".\\cocodataset\\validate",
                "--checkpoint_mask_estimator", ".\\artifacts\\last_mask_estimator.pt",
                "--output", ".\\artifacts\\inference_preview.png",
                "--num-examples", "4",
                "--batch-size", "4",
                "--num-workers", "0",
                "--threshold", "0.5"
            ]
        }
    ]
}
